# Скопируйте в .env и поменяйте пароль. Файл .env в git не попадает.

POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

# ---- LLM: вариант 1 — локально через Ollama (сервис ollama в docker-compose)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b

# ---- LLM: вариант 2 — OpenRouter (раскомментируйте и закомментируйте вариант 1)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen-2.5-7b-instruct

# ---- Отдельный, более сильный судья для проверки ответов и RAGAS (необязательно)
# JUDGE_BASE_URL=https://openrouter.ai/api/v1
# JUDGE_API_KEY=sk-or-...
# JUDGE_MODEL=openai/gpt-4o-mini

# ---- Поиск
RETRIEVAL_MODE=hybrid_rerank
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ---- Кэш
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_HOURS=24
